# Obsidian Vault Gitignore

# Temp files
TODO.md
*.tmp
.DS_Store

# Obsidian config (local e dinâmico)
.obsidian/workspace*
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/page-preview.json
.obsidian/webviewer.json

# Logs
*.log

# OS
# Thumbs.db
# ehthumbs.db

