.scripts/mcp-vault-server/package-lock.json

# Security & Secrets
.env
.env.local
.env.*.local
**/.env

# JARVIS Data Persistence (Keep diaries and memories)
# !JARVIS/Memorias/Diario/*.md
# !JARVIS/Memorias/Episodicas/*.md
